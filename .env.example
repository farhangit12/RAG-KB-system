# Copy this file to .env and fill in values. Never commit .env.

# --- Secrets ---
ANTHROPIC_API_KEY=

# --- Adapter choice (swap implementations here, no code changes) ---
VECTOR_STORE=chroma          # chroma | memory   (qdrant arrives in Slice 7)
EMBEDDER=chroma_default      # chroma_default | fake
LLM=anthropic                # anthropic | fake
LOADER=markdown              # markdown

# --- LLM ---
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=8000
LLM_EFFORT=medium
LLM_REFUSAL_FALLBACK=true

# --- Paths ---
CONTENT_DIR=content
DATA_DIR=data
COLLECTION_PUBLIC=disha_public

# --- Chunking and retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
EMBED_BATCH_SIZE=64
TOP_K=5

# --- Personalization ---
RETRIEVAL_CANDIDATES=20
BOOST_STAGE=0.10
BOOST_SECTOR=0.10
DISHA_PATH_SOURCE=frameworks/disha-path.md
DISHA_PATH_MIN_SCORE=0.30

# --- Evaluation ---
EVAL_QUESTIONS_PATH=eval/questions.yaml
REPORTS_DIR=reports

# --- Feedback ---
FEEDBACK_REPO=sqlite
# FEEDBACK_DB_PATH=data/feedback.db
MAX_ANSWER_CHARS=20000
MAX_COMMENT_CHARS=1000
MAX_FEEDBACK_SOURCES=20

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- API ---
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["https://disha-advisory-vert.vercel.app"]   # JSON list
MAX_QUESTION_CHARS=1000
MAX_SECTOR_CHARS=60
RATE_LIMITER=memory
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false    # set true on Render/Railway
