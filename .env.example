# Copy this file to .env and fill in values. Never commit .env.

# --- Secrets ---
ANTHROPIC_API_KEY=

# --- Adapter choice (swap implementations here, no code changes) ---
VECTOR_STORE=chroma          # chroma | memory   (qdrant arrives in Slice 7)
EMBEDDER=chroma_default      # chroma_default | fake
LLM=anthropic                # anthropic | fake
LOADER=markdown              # markdown

# --- LLM ---
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=8000
LLM_EFFORT=medium
LLM_REFUSAL_FALLBACK=true

# --- Paths ---
CONTENT_DIR=content
DATA_DIR=data
COLLECTION_PUBLIC=disha_public

# --- Chunking and retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
EMBED_BATCH_SIZE=64
TOP_K=5

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- API ---
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["https://disha-advisory-vert.vercel.app"]   # JSON list
MAX_QUESTION_CHARS=1000
MAX_SECTOR_CHARS=60
RATE_LIMITER=memory
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false    # set true on Render/Railway
