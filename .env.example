# Copy this file to .env and fill in values. Never commit .env.
# Zero-budget stack: every service below is free or open source (docs/decisions.md 007).

# --- Secrets ---
GROQ_API_KEY=                 # Groq free plan; never add billing details
ORACLE_PASSWORD=
ORACLE_WALLET_PASSWORD=
SERVICE_API_KEY=              # shared with the main Disha backend; required on every API call

# --- Adapter choice (swap implementations here, no code changes) ---
VECTOR_STORE=oracle          # oracle | chroma | memory
EMBEDDER=bge_m3              # bge_m3 | fake
RERANKER=bge                 # bge | fake
LLM=groq                     # groq | fake
LOADER=auto                  # auto (md, pdf, docx, txt, csv) | markdown
TOKENIZER=estimate           # estimate | hf (exact bge-m3 counts, needs the models extra)

# --- LLM (Groq, OpenAI-compatible API) ---
GROQ_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=1500

# --- Local models (run on our own VM) ---
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3
MODEL_DEVICE=cpu

# --- Oracle KB DB (Account 1, Always Free Autonomous AI Database) ---
ORACLE_USER=DISHA_KB
ORACLE_DSN=                  # from the ADB "Database connection" page
ORACLE_WALLET_DIR=           # folder with the unzipped wallet (empty for TLS without wallet)
ORACLE_TABLE=kb_chunks
ORACLE_APPROX_SEARCH=false   # true after creating the vector index (sql/oracle/001_kb_chunks.sql)

# --- Paths ---
CONTENT_DIR=content
DATA_DIR=data
COLLECTION_PUBLIC=disha_public
BACKUP_DIR=data/backups

# --- Chunking (tokens) and retrieval ---
MAX_FILE_MB=10
CHUNK_SIZE=500
CHUNK_OVERLAP=75
CSV_ROWS_PER_BLOCK=25
EMBED_BATCH_SIZE=16
TOP_K=20
RERANK_KEEP=3
RERANK_MIN_SCORE=0.2         # tune with `python -m app.cli eval`
PACK_TOKEN_BUDGET=1500
MAX_INPUT_TOKENS=6000

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- API (JSON list) ---
CORS_ORIGINS=["https://disha-advisory-vert.vercel.app"]
